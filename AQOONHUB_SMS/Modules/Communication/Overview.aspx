<%@ Page Title="Communication Overview" Language="C#" MasterPageFile="~/MasterPages/MainMaster.master" AutoEventWireup="true" CodeBehind="Overview.aspx.cs" Inherits="AQOONHUB_SMS.Modules.Communication.Overview" %>
<asp:Content ID="H" ContentPlaceHolderID="head" runat="server"><link href="<%=ResolveUrl("~/Assets/css/communication-module.css?v=3")%>" rel="stylesheet"/></asp:Content>
<asp:Content ID="B" ContentPlaceHolderID="MainContent" runat="server"><section class="comm"><header class="comm-head"><div><h1 class="text-2xl font-bold">Communication Overview</h1><p class="comm-sub">Monitor announcements, messages, outbound communication, and delivery performance.</p></div><div class="comm-actions"><a class="btn btn-primary" href="<%=ResolveUrl("~/Modules/Communication/Announcements.aspx?new=1")%>"><i data-lucide="megaphone"></i> New announcement</a><a class="btn btn-secondary" href="<%=ResolveUrl("~/Modules/Communication/Messages.aspx?compose=1")%>"><i data-lucide="message-square-plus"></i> Compose</a></div></header><asp:Literal ID="litMessage" runat="server"/>
<div class="comm-stats"><div class="comm-stat"><i data-lucide="megaphone" class="text-violet-600"></i><div><span>Total Announcements</span><b><asp:Literal ID="litAnnouncements" runat="server"/></b></div></div><div class="comm-stat"><i data-lucide="mail" class="text-emerald-600"></i><div><span>Unread Messages</span><b><asp:Literal ID="litUnread" runat="server"/></b></div></div><div class="comm-stat"><i data-lucide="message-circle" class="text-blue-600"></i><div><span>SMS Sent</span><b><asp:Literal ID="litSms" runat="server"/></b></div></div><div class="comm-stat"><i data-lucide="send" class="text-amber-600"></i><div><span>Emails Sent</span><b><asp:Literal ID="litEmail" runat="server"/></b></div></div><div class="comm-stat"><i data-lucide="triangle-alert" class="text-red-600"></i><div><span>Failed Deliveries</span><b><asp:Literal ID="litFailed" runat="server"/></b></div></div></div>
<div class="comm-grid"><section class="comm-panel"><h2 class="font-bold">Delivery Success - Last 7 Days</h2><p class="comm-sub">Delivered and failed records reported by configured providers.</p><div class="comm-chart"><canvas id="deliveryChart" role="img" aria-label="Delivered and failed communications during the last seven days"></canvas></div><details><summary class="text-sm text-blue-700 cursor-pointer">Accessible data table</summary><div class="comm-table-wrap"><asp:GridView ID="gvTrend" runat="server" AutoGenerateColumns="true" CssClass="comm-table"/></div></details></section><section class="comm-panel"><h2 class="font-bold mb-3">Recent Communications</h2><asp:Repeater ID="rpRecent" runat="server"><HeaderTemplate><div class="comm-list"></HeaderTemplate><ItemTemplate><article><b><%#H(Eval("Title"))%></b><p class="comm-sub"><%#H(Eval("Kind"))%> &middot; <%#Eval("CreatedAt","{0:dd MMM yyyy HH:mm}")%></p></article></ItemTemplate><FooterTemplate></div></FooterTemplate></asp:Repeater><asp:Panel ID="pnlRecentEmpty" runat="server" CssClass="comm-empty">No communication activity exists yet.</asp:Panel></section></div>
<div class="comm-grid equal"><section class="comm-panel"><h2 class="font-bold">Communication by Channel</h2><div class="comm-chart"><canvas id="channelChart" role="img" aria-label="Communication delivery count by channel"></canvas></div></section><section class="comm-panel"><h2 class="font-bold">Communication by Status</h2><div class="comm-chart"><canvas id="statusChart" role="img" aria-label="Communication delivery count by status"></canvas></div></section></div>
<section class="comm-panel"><h2 class="font-bold mb-3">Upcoming Scheduled Communications</h2><div class="comm-table-wrap"><asp:GridView ID="gvUpcoming" runat="server" AutoGenerateColumns="true" CssClass="comm-table" EmptyDataText="No scheduled communications exist. Scheduler execution is not claimed unless a runner is configured."/></div></section>
<asp:HiddenField ID="hidTrendLabels" runat="server"/><asp:HiddenField ID="hidDelivered" runat="server"/><asp:HiddenField ID="hidFailedChart" runat="server"/><asp:HiddenField ID="hidChannelLabels" runat="server"/><asp:HiddenField ID="hidChannelValues" runat="server"/><asp:HiddenField ID="hidStatusLabels" runat="server"/><asp:HiddenField ID="hidStatusValues" runat="server"/></section><script src="<%=ResolveUrl("~/Assets/js/modules/communication/communication-module.js?v=5")%>"></script><script>(function(){function j(id){try{return JSON.parse(document.getElementById(id).value||'[]')}catch(e){return[]}}function colors(){var d=document.documentElement.classList.contains('dark');return{grid:d?'#334155':'#e2e8f0',text:d?'#cbd5e1':'#475569'}}function draw(){if(!window.Chart)return;var c=colors(),common={responsive:true,maintainAspectRatio:false,plugins:{legend:{labels:{color:c.text}}},scales:{x:{ticks:{color:c.text},grid:{color:c.grid}},y:{beginAtZero:true,ticks:{color:c.text},grid:{color:c.grid}}}};new Chart(document.getElementById('deliveryChart'),{type:'line',data:{labels:j('<%=hidTrendLabels.ClientID%>'),datasets:[{label:'Delivered',data:j('<%=hidDelivered.ClientID%>'),borderColor:'#16a34a',backgroundColor:'rgba(22,163,74,.12)',fill:true,tension:.3},{label:'Failed',data:j('<%=hidFailedChart.ClientID%>'),borderColor:'#dc2626',borderDash:[5,4],tension:.3}]},options:common});var donut=function(id,labels,values,palette){new Chart(document.getElementById(id),{type:'doughnut',data:{labels:labels,datasets:[{data:values,backgroundColor:palette}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'bottom',labels:{color:c.text}}}}})};donut('channelChart',j('<%=hidChannelLabels.ClientID%>'),j('<%=hidChannelValues.ClientID%>'),['#2563eb','#7c3aed','#0ea5e9']);donut('statusChart',j('<%=hidStatusLabels.ClientID%>'),j('<%=hidStatusValues.ClientID%>'),['#16a34a','#2563eb','#f59e0b','#dc2626','#64748b'])}document.addEventListener('DOMContentLoaded',draw)})();</script></asp:Content>
