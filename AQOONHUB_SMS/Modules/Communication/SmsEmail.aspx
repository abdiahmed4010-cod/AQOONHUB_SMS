<%@ Page Title="SMS & Email" Language="C#" MasterPageFile="~/MasterPages/MainMaster.master" AutoEventWireup="true" CodeBehind="SmsEmail.aspx.cs" Inherits="AQOONHUB_SMS.Modules.Communication.SmsEmail" %>
<asp:Content ID="H" ContentPlaceHolderID="head" runat="server"><link href="<%=ResolveUrl("~/Assets/css/communication-module.css?v=3")%>" rel="stylesheet"/></asp:Content><asp:Content ID="B" ContentPlaceHolderID="MainContent" runat="server"><section class="comm"><header class="comm-head"><div><h1 class="text-2xl font-bold">SMS &amp; Email</h1><p class="comm-sub">Compose, schedule, and track outbound communications.</p></div></header><asp:Literal ID="litMessage" runat="server"/><nav class="comm-tabs" aria-label="SMS and Email sections"><asp:LinkButton ID="tabCompose" runat="server" CssClass="comm-tab active" CommandArgument="compose" OnClick="Tab_Click">Compose</asp:LinkButton><asp:LinkButton ID="tabTemplates" runat="server" CssClass="comm-tab" CommandArgument="templates" OnClick="Tab_Click">Templates</asp:LinkButton><asp:LinkButton ID="tabCampaigns" runat="server" CssClass="comm-tab" CommandArgument="campaigns" OnClick="Tab_Click">Campaigns</asp:LinkButton><asp:LinkButton ID="tabScheduled" runat="server" CssClass="comm-tab" CommandArgument="scheduled" OnClick="Tab_Click">Scheduled</asp:LinkButton><asp:LinkButton ID="tabProvider" runat="server" CssClass="comm-tab" CommandArgument="provider" OnClick="Tab_Click">Provider Status</asp:LinkButton></nav>
<asp:MultiView ID="views" runat="server" ActiveViewIndex="0"><asp:View ID="viewCompose" runat="server"><asp:HiddenField ID="hidCampaign" runat="server"/><div class="comm-grid"><section class="comm-panel"><div class="comm-form two"><div class="comm-field"><label for="<%=ddlChannel.ClientID%>">Channel</label><asp:DropDownList ID="ddlChannel" runat="server" CssClass="comm-control" AutoPostBack="true" OnSelectedIndexChanged="Channel_Changed"><asp:ListItem>SMS</asp:ListItem><asp:ListItem>Email</asp:ListItem></asp:DropDownList></div><div class="comm-field"><label for="<%=ddlRecipientType.ClientID%>">Recipient group</label><asp:DropDownList ID="ddlRecipientType" runat="server" CssClass="comm-control"><asp:ListItem>Individual User</asp:ListItem><asp:ListItem>Specific Role</asp:ListItem><asp:ListItem>Specific Class</asp:ListItem><asp:ListItem>Specific Section</asp:ListItem><asp:ListItem>All Parents</asp:ListItem><asp:ListItem>All Teachers</asp:ListItem><asp:ListItem>Parents of Absent Students</asp:ListItem><asp:ListItem>Parents with Outstanding Fees</asp:ListItem></asp:DropDownList></div><div class="comm-field"><label for="<%=ddlRecipient.ClientID%>">Recipient / value</label><asp:DropDownList ID="ddlRecipient" runat="server" CssClass="comm-control"/></div><div class="comm-field"><label for="<%=ddlTemplate.ClientID%>">Template</label><asp:DropDownList ID="ddlTemplate" runat="server" CssClass="comm-control" AutoPostBack="true" OnSelectedIndexChanged="Template_Changed"/></div><asp:Panel ID="pnlSubject" runat="server" CssClass="comm-field wide"><label for="<%=txtSubject.ClientID%>">Email subject</label><asp:TextBox ID="txtSubject" runat="server" CssClass="comm-control" MaxLength="200"/></asp:Panel><div class="comm-field wide"><label for="<%=txtBody.ClientID%>">Message *</label><asp:TextBox ID="txtBody" runat="server" CssClass="comm-control" TextMode="MultiLine" Rows="8" MaxLength="2000"/></div><div class="comm-field"><label for="<%=ddlTiming.ClientID%>">Delivery timing</label><asp:DropDownList ID="ddlTiming" runat="server" CssClass="comm-control"><asp:ListItem>Send Now</asp:ListItem><asp:ListItem>Schedule Later</asp:ListItem></asp:DropDownList></div><div class="comm-field"><label for="<%=txtSchedule.ClientID%>">Schedule date/time</label><asp:TextBox ID="txtSchedule" runat="server" TextMode="DateTimeLocal" CssClass="comm-control"/></div></div><div class="comm-actions-sticky"><asp:Button ID="btnPreview" runat="server" Text="Preview" CssClass="btn btn-secondary" OnClick="btnPreview_Click"/><asp:Button ID="btnDraft" runat="server" Text="Save Draft" CssClass="btn btn-secondary" OnClick="btnDraft_Click"/><asp:Button ID="btnSend" runat="server" Text="Send or Schedule" CssClass="btn btn-primary" OnClick="btnSend_Click"/></div></section><aside class="comm-panel"><h2 class="font-bold mb-3">Provider Status</h2><asp:Literal ID="litProviderSummary" runat="server"/><p class="comm-sub mt-4">Provider secrets are never displayed. Configure providers in existing Settings.</p><a href="<%=ResolveUrl("~/Modules/Settings/Settings.aspx")%>" class="btn btn-secondary mt-4">Go to Settings</a></aside></div></asp:View>
<asp:View ID="viewTemplates" runat="server"><section class="comm-panel"><h2 class="font-bold mb-4">Communication Templates</h2><asp:Panel ID="pnlTemplateForm" runat="server" CssClass="comm-form two"><div class="comm-field"><label for="<%=txtTemplateName.ClientID%>">Template name</label><asp:TextBox ID="txtTemplateName" runat="server" CssClass="comm-control" MaxLength="120"/></div><div class="comm-field"><label for="<%=templateChannel.ClientID%>">Channel</label><asp:DropDownList ID="templateChannel" runat="server" CssClass="comm-control"><asp:ListItem>SMS</asp:ListItem><asp:ListItem>Email</asp:ListItem></asp:DropDownList></div><div class="comm-field"><label for="<%=txtCategory.ClientID%>">Category</label><asp:TextBox ID="txtCategory" runat="server" CssClass="comm-control" MaxLength="50"/></div><div class="comm-field"><label for="<%=txtTemplateSubject.ClientID%>">Email subject</label><asp:TextBox ID="txtTemplateSubject" runat="server" CssClass="comm-control" MaxLength="200"/></div><div class="comm-field wide"><label for="<%=txtTemplateBody.ClientID%>">Message body</label><asp:TextBox ID="txtTemplateBody" runat="server" CssClass="comm-control" TextMode="MultiLine" Rows="5" MaxLength="2000"/><small>Allowed placeholders: {{StudentName}}, {{ParentName}}, {{ClassName}}, {{SectionName}}, {{AmountDue}}, {{DueDate}}, {{ExamDate}}, {{SchoolName}}.</small></div><asp:Button ID="btnTemplateSave" runat="server" Text="Add Template" CssClass="btn btn-primary" OnClick="btnTemplateSave_Click"/></asp:Panel><div class="comm-table-wrap"><asp:GridView ID="gvTemplates" runat="server" AutoGenerateColumns="true" CssClass="comm-table" EmptyDataText="No templates exist." OnRowCommand="gvTemplates_RowCommand"><Columns><asp:TemplateField HeaderText="Actions"><ItemTemplate><asp:LinkButton runat="server" CssClass="btn btn-secondary" CommandName="ToggleTemplate" CommandArgument='<%#Eval("TemplateID")%>'>Activate / Deactivate</asp:LinkButton> <asp:LinkButton runat="server" CssClass="btn btn-secondary" CommandName="DeleteTemplate" CommandArgument='<%#Eval("TemplateID")%>' OnClientClick="return confirm('Delete this template?');">Delete</asp:LinkButton></ItemTemplate></asp:TemplateField></Columns></asp:GridView></div></section></asp:View>
<asp:View ID="viewCampaigns" runat="server"><section class="comm-panel"><h2 class="font-bold mb-3">Campaigns</h2><div class="comm-table-wrap"><asp:GridView ID="gvCampaigns" runat="server" AutoGenerateColumns="true" CssClass="comm-table" EmptyDataText="No campaigns exist." OnRowCommand="gvCampaigns_RowCommand"><Columns><asp:TemplateField HeaderText="Actions"><ItemTemplate><asp:LinkButton runat="server" CssClass="btn btn-secondary" CommandName="ViewCampaign" CommandArgument='<%#Eval("CampaignID")%>'>View</asp:LinkButton> <asp:LinkButton runat="server" CssClass="btn btn-secondary" CommandName="EditCampaign" CommandArgument='<%#Eval("CampaignID")%>'>Edit</asp:LinkButton> <asp:LinkButton runat="server" CssClass="btn btn-secondary" CommandName="DuplicateCampaign" CommandArgument='<%#Eval("CampaignID")%>'>Duplicate</asp:LinkButton> <asp:LinkButton runat="server" CssClass="btn btn-secondary" CommandName="CancelCampaign" CommandArgument='<%#Eval("CampaignID")%>'>Cancel</asp:LinkButton> <asp:LinkButton runat="server" CssClass="btn btn-secondary" CommandName="DeleteCampaign" CommandArgument='<%#Eval("CampaignID")%>' OnClientClick="return confirm('Delete this draft campaign?');">Delete Draft</asp:LinkButton></ItemTemplate></asp:TemplateField></Columns></asp:GridView></div></section></asp:View><asp:View ID="viewScheduled" runat="server"><section class="comm-panel"><div class="comm-note">No background scheduler is configured by this module. Definitions remain <b>Pending Scheduler Configuration</b> and are not marked sent.</div><div class="comm-table-wrap"><asp:GridView ID="gvScheduled" runat="server" AutoGenerateColumns="true" CssClass="comm-table" EmptyDataText="No scheduled communications exist." OnRowCommand="gvCampaigns_RowCommand"><Columns><asp:TemplateField HeaderText="Actions"><ItemTemplate><asp:LinkButton runat="server" CssClass="btn btn-secondary" CommandName="ViewCampaign" CommandArgument='<%#Eval("CampaignID")%>'>View</asp:LinkButton> <asp:LinkButton runat="server" CssClass="btn btn-secondary" CommandName="EditCampaign" CommandArgument='<%#Eval("CampaignID")%>'>Edit</asp:LinkButton> <asp:LinkButton runat="server" CssClass="btn btn-secondary" CommandName="CancelCampaign" CommandArgument='<%#Eval("CampaignID")%>'>Cancel</asp:LinkButton></ItemTemplate></asp:TemplateField></Columns></asp:GridView></div></section></asp:View><asp:View ID="viewProvider" runat="server"><section class="comm-panel"><h2 class="font-bold mb-3">Provider Status</h2><asp:Literal ID="litProviderDetails" runat="server"/></section></asp:View></asp:MultiView></section><script src="<%=ResolveUrl("~/Assets/js/modules/communication/communication-module.js?v=5")%>"></script></asp:Content>
