<%@ Page Title="Messages" Language="C#" MasterPageFile="~/MasterPages/MainMaster.master" AutoEventWireup="true" CodeBehind="Messages.aspx.cs" Inherits="AQOONHUB_SMS.Modules.Communication.Messages" %>
<asp:Content ID="H" ContentPlaceHolderID="head" runat="server"><link href="<%=ResolveUrl("~/Assets/css/communication-module.css?v=3")%>" rel="stylesheet"/></asp:Content><asp:Content ID="B" ContentPlaceHolderID="MainContent" runat="server"><section class="comm"><header class="comm-head"><div><h1 class="text-2xl font-bold">Messages</h1><p class="comm-sub">Send and manage secure in-app messages.</p></div><asp:Button ID="btnCompose" runat="server" Text="Compose Message" CssClass="btn btn-primary" OnClick="btnCompose_Click"/></header><asp:Literal ID="litMessage" runat="server"/><nav class="comm-tabs" aria-label="Message folders"><asp:LinkButton ID="tabInbox" runat="server" CssClass="comm-tab active" CommandArgument="inbox" OnClick="Tab_Click">Inbox</asp:LinkButton><asp:LinkButton ID="tabSent" runat="server" CssClass="comm-tab" CommandArgument="sent" OnClick="Tab_Click">Sent</asp:LinkButton><asp:LinkButton ID="tabDrafts" runat="server" CssClass="comm-tab" CommandArgument="drafts" OnClick="Tab_Click">Drafts</asp:LinkButton><asp:LinkButton ID="tabArchived" runat="server" CssClass="comm-tab" CommandArgument="archived" OnClick="Tab_Click">Archived</asp:LinkButton></nav><section class="comm-panel"><div class="comm-filters"><div class="comm-field"><label for="<%=txtSearch.ClientID%>">Search</label><asp:TextBox ID="txtSearch" runat="server" CssClass="comm-control"/></div><div class="comm-field"><label for="<%=ddlStatus.ClientID%>">Status</label><asp:DropDownList ID="ddlStatus" runat="server" CssClass="comm-control"><asp:ListItem Value="">All statuses</asp:ListItem><asp:ListItem>Unread</asp:ListItem><asp:ListItem>Read</asp:ListItem><asp:ListItem>Draft</asp:ListItem><asp:ListItem>Archived</asp:ListItem></asp:DropDownList></div><div class="comm-actions"><asp:Button ID="btnFilter" runat="server" Text="Apply" CssClass="btn btn-primary" OnClick="btnFilter_Click"/><asp:Button ID="btnReset" runat="server" Text="Reset" CssClass="btn btn-secondary" OnClick="btnReset_Click"/></div></div><div class="comm-table-wrap"><asp:GridView ID="gv" runat="server" AutoGenerateColumns="false" CssClass="comm-table" GridLines="None" OnRowCommand="gv_RowCommand"><Columns><asp:BoundField DataField="Person" HeaderText="Sender or Recipient"/><asp:BoundField DataField="Subject" HeaderText="Subject"/><asp:BoundField DataField="Preview" HeaderText="Message Preview"/><asp:BoundField DataField="CreatedAt" HeaderText="Date" DataFormatString="{0:dd MMM yyyy HH:mm}"/><asp:BoundField DataField="Status" HeaderText="Status"/><asp:TemplateField HeaderText="Actions"><ItemTemplate><div class="comm-actions"><asp:LinkButton runat="server" CssClass="btn btn-secondary" CommandName="ViewThread" CommandArgument='<%#Eval("ThreadID")%>'>View</asp:LinkButton><asp:LinkButton runat="server" CssClass="btn btn-secondary" CommandName="ReplyThread" CommandArgument='<%#Eval("ThreadID")%>'>Reply</asp:LinkButton><asp:LinkButton runat="server" CssClass="btn btn-secondary" CommandName="ForwardThread" CommandArgument='<%#Eval("ThreadID")%>'>Forward</asp:LinkButton><asp:LinkButton runat="server" CssClass="btn btn-secondary" CommandName="UnreadMessage" CommandArgument='<%#Eval("MessageID")%>'>Mark Unread</asp:LinkButton><asp:LinkButton runat="server" CssClass="btn btn-secondary" CommandName="ArchiveMessage" CommandArgument='<%#Eval("MessageID")%>'>Archive</asp:LinkButton><asp:LinkButton runat="server" CssClass="btn btn-secondary" CommandName="DeleteMessage" CommandArgument='<%#Eval("MessageID")%>' OnClientClick="return confirm('Remove this message from your mailbox?');">Delete</asp:LinkButton></div></ItemTemplate></asp:TemplateField></Columns><EmptyDataTemplate><div class="comm-empty">No messages exist in this folder.</div></EmptyDataTemplate></asp:GridView></div><div class="comm-pager"><asp:Literal ID="litPage" runat="server"/><div class="comm-actions"><asp:Button ID="btnPrev" runat="server" Text="Previous" CssClass="btn btn-secondary" OnClick="btnPrev_Click"/><asp:Button ID="btnNext" runat="server" Text="Next" CssClass="btn btn-secondary" OnClick="btnNext_Click"/><asp:DropDownList ID="ddlPageSize" runat="server" CssClass="comm-control" AutoPostBack="true" OnSelectedIndexChanged="PageSize_Changed"><asp:ListItem>10</asp:ListItem><asp:ListItem>25</asp:ListItem><asp:ListItem>50</asp:ListItem><asp:ListItem>100</asp:ListItem></asp:DropDownList></div></div></section>
<div id="comm-scrim" class="comm-scrim" hidden onclick="commClose()"></div><asp:Panel ID="pnlCompose" runat="server" CssClass="comm-modal" Visible="false" role="dialog" aria-modal="true" aria-labelledby="compose-title"><h2 id="compose-title" class="text-xl font-bold mb-4">Compose Message</h2><asp:HiddenField ID="hidThread" runat="server"/><div class="comm-form"><div class="comm-field wide"><label for="<%=ddlRecipient.ClientID%>">Recipient *</label><asp:DropDownList ID="ddlRecipient" runat="server" CssClass="comm-control"/></div><div class="comm-field wide"><label for="<%=txtSubject.ClientID%>">Subject *</label><asp:TextBox ID="txtSubject" runat="server" CssClass="comm-control" MaxLength="200"/></div><div class="comm-field wide"><label for="<%=txtBody.ClientID%>">Message *</label><asp:TextBox ID="txtBody" runat="server" CssClass="comm-control" TextMode="MultiLine" Rows="7" MaxLength="4000"/></div><div class="comm-field wide"><label for="<%=upload.ClientID%>">Attachment (PDF, DOCX, XLSX, JPG or PNG; 5 MB maximum)</label><asp:FileUpload ID="upload" runat="server" CssClass="comm-control" accept=".pdf,.docx,.xlsx,.jpg,.jpeg,.png"/></div></div><div class="comm-actions-sticky"><asp:Button ID="btnComposeClose" runat="server" Text="Cancel" CssClass="btn btn-secondary" OnClick="btnComposeClose_Click" CausesValidation="false"/><asp:Button ID="btnSaveDraft" runat="server" Text="Save Draft" CssClass="btn btn-secondary" OnClick="btnSaveDraft_Click"/><asp:Button ID="btnSend" runat="server" Text="Send" CssClass="btn btn-primary" OnClick="btnSend_Click"/></div></asp:Panel><asp:Panel ID="pnlThread" runat="server" CssClass="comm-drawer" Visible="false" role="dialog" aria-modal="true" aria-labelledby="thread-title"><div class="comm-head"><h2 id="thread-title" class="text-xl font-bold"><asp:Literal ID="litThreadTitle" runat="server"/></h2><asp:Button ID="btnThreadClose" runat="server" Text="Close" CssClass="btn btn-secondary" OnClick="btnThreadClose_Click"/></div><asp:Repeater ID="rpThread" runat="server"><HeaderTemplate><div class="comm-list"></HeaderTemplate><ItemTemplate><article><b><%#H(Eval("Sender"))%></b><p class="comm-sub"><%#Eval("CreatedAt","{0:dd MMM yyyy HH:mm}")%> · <%#H(Eval("ReadState"))%></p><p class="mt-2 whitespace-pre-wrap"><%#H(Eval("Body"))%></p><%#AttachmentLinks(Eval("MessageID"))%></article></ItemTemplate><FooterTemplate></div></FooterTemplate></asp:Repeater></asp:Panel></section><script src="<%=ResolveUrl("~/Assets/js/modules/communication/communication-module.js?v=5")%>"></script></asp:Content>
