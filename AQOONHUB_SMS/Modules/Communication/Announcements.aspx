<%@ Page Title="Announcements" Language="C#" MasterPageFile="~/MasterPages/MainMaster.master" AutoEventWireup="true" CodeBehind="Announcements.aspx.cs" Inherits="AQOONHUB_SMS.Modules.Communication.Announcements" %>
<asp:Content ID="H" ContentPlaceHolderID="head" runat="server"><link href="<%=ResolveUrl("~/Assets/css/communication-module.css?v=3")%>" rel="stylesheet"/></asp:Content><asp:Content ID="B" ContentPlaceHolderID="MainContent" runat="server"><section class="comm"><header class="comm-head"><div><h1 class="text-2xl font-bold">Announcements</h1><p class="comm-sub">Create, publish, schedule, and manage school announcements.</p></div><asp:Button ID="btnNew" runat="server" Text="New Announcement" CssClass="btn btn-primary" OnClick="btnNew_Click"/></header><asp:Literal ID="litMessage" runat="server"/><section class="comm-panel"><div class="comm-filters"><div class="comm-field"><label for="<%=txtSearch.ClientID%>">Search</label><asp:TextBox ID="txtSearch" runat="server" CssClass="comm-control" MaxLength="200"/></div><div class="comm-field"><label for="<%=ddlAudience.ClientID%>">Audience</label><asp:DropDownList ID="ddlAudience" runat="server" CssClass="comm-control"><asp:ListItem Value="">All audiences</asp:ListItem><asp:ListItem>All Users</asp:ListItem><asp:ListItem>Students</asp:ListItem><asp:ListItem>Parents</asp:ListItem><asp:ListItem>Teachers</asp:ListItem><asp:ListItem>Staff</asp:ListItem><asp:ListItem>Specific Role</asp:ListItem><asp:ListItem>Specific Class</asp:ListItem><asp:ListItem>Specific Section</asp:ListItem><asp:ListItem>Selected Users</asp:ListItem></asp:DropDownList></div><div class="comm-field"><label for="<%=ddlPriority.ClientID%>">Priority</label><asp:DropDownList ID="ddlPriority" runat="server" CssClass="comm-control"><asp:ListItem Value="">All priorities</asp:ListItem><asp:ListItem>Normal</asp:ListItem><asp:ListItem>Important</asp:ListItem><asp:ListItem>Urgent</asp:ListItem></asp:DropDownList></div><div class="comm-field"><label for="<%=ddlStatus.ClientID%>">Status</label><asp:DropDownList ID="ddlStatus" runat="server" CssClass="comm-control"><asp:ListItem Value="">All statuses</asp:ListItem><asp:ListItem>Draft</asp:ListItem><asp:ListItem>Scheduled</asp:ListItem><asp:ListItem>Published</asp:ListItem><asp:ListItem>Expired</asp:ListItem><asp:ListItem>Unpublished</asp:ListItem><asp:ListItem>Cancelled</asp:ListItem></asp:DropDownList></div><div class="comm-field"><label for="<%=txtFrom.ClientID%>">Publish from</label><asp:TextBox ID="txtFrom" runat="server" TextMode="Date" CssClass="comm-control"/></div><div class="comm-field"><label for="<%=txtTo.ClientID%>">Publish to</label><asp:TextBox ID="txtTo" runat="server" TextMode="Date" CssClass="comm-control"/></div><div class="comm-actions"><asp:Button ID="btnFilter" runat="server" Text="Apply filters" CssClass="btn btn-primary" OnClick="btnFilter_Click"/><asp:Button ID="btnReset" runat="server" Text="Reset" CssClass="btn btn-secondary" OnClick="btnReset_Click"/></div></div><div class="comm-table-wrap"><asp:GridView ID="gv" runat="server" AutoGenerateColumns="false" CssClass="comm-table" GridLines="None" DataKeyNames="AnnouncementID" OnRowCommand="gv_RowCommand"><Columns><asp:BoundField DataField="Title" HeaderText="Title"/><asp:BoundField DataField="Audience" HeaderText="Audience"/><asp:BoundField DataField="Priority" HeaderText="Priority"/><asp:BoundField DataField="PublishedBy" HeaderText="Published By"/><asp:BoundField DataField="PublishDate" HeaderText="Publish Date" DataFormatString="{0:dd MMM yyyy HH:mm}"/><asp:BoundField DataField="ExpiryDate" HeaderText="Expiry Date" DataFormatString="{0:dd MMM yyyy HH:mm}"/><asp:BoundField DataField="Status" HeaderText="Status"/><asp:TemplateField HeaderText="Actions"><ItemTemplate><div class="comm-actions"><asp:LinkButton runat="server" CssClass="btn btn-secondary" CommandName="ViewItem" CommandArgument='<%#Eval("AnnouncementID")%>'>View</asp:LinkButton><asp:LinkButton runat="server" CssClass="btn btn-secondary" CommandName="EditItem" CommandArgument='<%#Eval("AnnouncementID")%>' Visible='<%#CanManage%>'>Edit</asp:LinkButton><asp:LinkButton runat="server" CssClass="btn btn-secondary" CommandName="PublishItem" CommandArgument='<%#Eval("AnnouncementID")%>' Visible='<%#CanManage%>'>Publish</asp:LinkButton><asp:LinkButton runat="server" CssClass="btn btn-secondary" CommandName="UnpublishItem" CommandArgument='<%#Eval("AnnouncementID")%>' Visible='<%#CanManage%>'>Unpublish</asp:LinkButton><asp:LinkButton runat="server" CssClass="btn btn-secondary" CommandName="CancelItem" CommandArgument='<%#Eval("AnnouncementID")%>' Visible='<%#CanManage%>' OnClientClick="return confirm('Cancel this scheduled announcement?');">Cancel</asp:LinkButton><asp:LinkButton runat="server" CssClass="btn btn-secondary" CommandName="DeleteItem" CommandArgument='<%#Eval("AnnouncementID")%>' Visible='<%#CanManage%>' OnClientClick="return confirm('Delete this draft announcement? Only drafts can be deleted.');">Delete Draft</asp:LinkButton></div></ItemTemplate></asp:TemplateField></Columns><EmptyDataTemplate><div class="comm-empty">No announcements match the current filters.</div></EmptyDataTemplate></asp:GridView></div><div class="comm-pager"><asp:Literal ID="litPage" runat="server"/><div class="comm-actions"><asp:Button ID="btnPrev" runat="server" Text="Previous" CssClass="btn btn-secondary" OnClick="btnPrev_Click"/><asp:Button ID="btnNext" runat="server" Text="Next" CssClass="btn btn-secondary" OnClick="btnNext_Click"/><asp:DropDownList ID="ddlPageSize" runat="server" CssClass="comm-control" AutoPostBack="true" OnSelectedIndexChanged="ddlPageSize_Changed"><asp:ListItem>10</asp:ListItem><asp:ListItem>25</asp:ListItem><asp:ListItem>50</asp:ListItem><asp:ListItem>100</asp:ListItem></asp:DropDownList></div></div></section>
<div id="comm-scrim" class="comm-scrim" hidden onclick="commClose()"></div><asp:Panel ID="pnlForm" runat="server" CssClass="comm-modal" Visible="false" role="dialog" aria-modal="true" aria-labelledby="announcement-form-title"><h2 id="announcement-form-title" class="text-xl font-bold mb-4"><asp:Literal ID="litFormTitle" runat="server"/></h2><asp:HiddenField ID="hidId" runat="server"/><div class="comm-form two"><div class="comm-field wide"><label for="<%=txtTitle.ClientID%>">Title *</label><asp:TextBox ID="txtTitle" runat="server" CssClass="comm-control" MaxLength="200"/></div><div class="comm-field wide"><label for="<%=txtBody.ClientID%>">Message body *</label><asp:TextBox ID="txtBody" runat="server" CssClass="comm-control" TextMode="MultiLine" Rows="6" MaxLength="4000"/></div><div class="comm-field"><label for="<%=formPriority.ClientID%>">Priority</label><asp:DropDownList ID="formPriority" runat="server" CssClass="comm-control"><asp:ListItem>Normal</asp:ListItem><asp:ListItem>Important</asp:ListItem><asp:ListItem>Urgent</asp:ListItem></asp:DropDownList></div><div class="comm-field"><label for="<%=formAudience.ClientID%>">Audience type</label><asp:DropDownList ID="formAudience" runat="server" CssClass="comm-control" AutoPostBack="true" OnSelectedIndexChanged="formAudience_Changed"><asp:ListItem>All Users</asp:ListItem><asp:ListItem>Students</asp:ListItem><asp:ListItem>Parents</asp:ListItem><asp:ListItem>Teachers</asp:ListItem><asp:ListItem>Staff</asp:ListItem><asp:ListItem>Specific Role</asp:ListItem><asp:ListItem>Specific Class</asp:ListItem><asp:ListItem>Specific Section</asp:ListItem><asp:ListItem>Selected Users</asp:ListItem></asp:DropDownList></div><asp:Panel ID="pnlRole" runat="server" CssClass="comm-field"><label for="<%=formRole.ClientID%>">Role</label><asp:DropDownList ID="formRole" runat="server" CssClass="comm-control"/></asp:Panel><asp:Panel ID="pnlClass" runat="server" CssClass="comm-field"><label for="<%=formClass.ClientID%>">Class</label><asp:DropDownList ID="formClass" runat="server" CssClass="comm-control" AutoPostBack="true" OnSelectedIndexChanged="formClass_Changed"/></asp:Panel><asp:Panel ID="pnlSection" runat="server" CssClass="comm-field"><label for="<%=formSection.ClientID%>">Section</label><asp:DropDownList ID="formSection" runat="server" CssClass="comm-control"/></asp:Panel><asp:Panel ID="pnlUser" runat="server" CssClass="comm-field"><label for="<%=formUser.ClientID%>">User</label><asp:DropDownList ID="formUser" runat="server" CssClass="comm-control"/></asp:Panel><div class="comm-field"><label for="<%=formPublish.ClientID%>">Publish date/time</label><asp:TextBox ID="formPublish" runat="server" TextMode="DateTimeLocal" CssClass="comm-control"/></div><div class="comm-field"><label for="<%=formExpiry.ClientID%>">Expiry date/time</label><asp:TextBox ID="formExpiry" runat="server" TextMode="DateTimeLocal" CssClass="comm-control"/></div><div class="comm-field wide"><label for="<%=upload.ClientID%>">Attachment</label><asp:FileUpload ID="upload" runat="server" CssClass="comm-control"/><small>PDF, DOCX, XLSX, JPG, JPEG or PNG; maximum 5 MB.</small></div></div><div class="comm-actions-sticky"><asp:Button ID="btnClose" runat="server" Text="Cancel" CssClass="btn btn-secondary" OnClick="btnClose_Click" CausesValidation="false"/><asp:Button ID="btnDraft" runat="server" Text="Save Draft" CssClass="btn btn-secondary" OnClick="btnDraft_Click"/><asp:Button ID="btnSchedule" runat="server" Text="Schedule" CssClass="btn btn-secondary" OnClick="btnSchedule_Click"/><asp:Button ID="btnPublish" runat="server" Text="Publish Now" CssClass="btn btn-primary" OnClick="btnPublish_Click"/></div></asp:Panel>
<asp:Panel ID="pnlDetails" runat="server" CssClass="comm-drawer" Visible="false" role="dialog" aria-modal="true" aria-labelledby="announcement-details-title"><div class="comm-head"><h2 id="announcement-details-title" class="text-xl font-bold">Announcement Details</h2><asp:Button ID="btnDetailsClose" runat="server" Text="Close" CssClass="btn btn-secondary" OnClick="btnDetailsClose_Click"/></div><dl class="comm-detail"><asp:Literal ID="litDetails" runat="server"/></dl></asp:Panel></section><script src="<%=ResolveUrl("~/Assets/js/modules/communication/communication-module.js?v=5")%>"></script></asp:Content>
