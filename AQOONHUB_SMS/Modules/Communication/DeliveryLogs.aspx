<%@ Page Title="Delivery Logs" Language="C#" MasterPageFile="~/MasterPages/MainMaster.master" AutoEventWireup="true" CodeBehind="DeliveryLogs.aspx.cs" Inherits="AQOONHUB_SMS.Modules.Communication.DeliveryLogs" %>
<asp:Content ID="H" ContentPlaceHolderID="head" runat="server"><link href="<%=ResolveUrl("~/Assets/css/communication-module.css?v=3")%>" rel="stylesheet"/></asp:Content><asp:Content ID="B" ContentPlaceHolderID="MainContent" runat="server"><section class="comm"><header class="comm-head"><div><h1 class="text-2xl font-bold">Delivery Logs</h1><p class="comm-sub">Track communication processing and delivery status.</p></div><asp:Button ID="btnExport" runat="server" Text="Export CSV" CssClass="btn btn-primary" OnClick="btnExport_Click"/></header><asp:Literal ID="litMessage" runat="server"/><div class="comm-stats"><div class="comm-stat"><i data-lucide="list"></i><div><span>Total Deliveries</span><b><asp:Literal ID="litTotal" runat="server"/></b></div></div><div class="comm-stat"><i data-lucide="send" class="text-blue-600"></i><div><span>Sent</span><b><asp:Literal ID="litSent" runat="server"/></b></div></div><div class="comm-stat"><i data-lucide="badge-check" class="text-emerald-600"></i><div><span>Delivered</span><b><asp:Literal ID="litDelivered" runat="server"/></b></div></div><div class="comm-stat"><i data-lucide="circle-x" class="text-red-600"></i><div><span>Failed</span><b><asp:Literal ID="litFailed" runat="server"/></b></div></div><div class="comm-stat"><i data-lucide="clock" class="text-amber-600"></i><div><span>Pending</span><b><asp:Literal ID="litPending" runat="server"/></b></div></div></div><section class="comm-panel"><div class="comm-filters"><div class="comm-field"><label for="<%=txtFrom.ClientID%>">From</label><asp:TextBox ID="txtFrom" runat="server" TextMode="Date" CssClass="comm-control"/></div><div class="comm-field"><label for="<%=txtTo.ClientID%>">To</label><asp:TextBox ID="txtTo" runat="server" TextMode="Date" CssClass="comm-control"/></div><div class="comm-field"><label for="<%=ddlChannel.ClientID%>">Channel</label><asp:DropDownList ID="ddlChannel" runat="server" CssClass="comm-control"><asp:ListItem Value="">All channels</asp:ListItem><asp:ListItem>SMS</asp:ListItem><asp:ListItem>Email</asp:ListItem><asp:ListItem>In-App</asp:ListItem></asp:DropDownList></div><div class="comm-field"><label for="<%=ddlStatus.ClientID%>">Status</label><asp:DropDownList ID="ddlStatus" runat="server" CssClass="comm-control"><asp:ListItem Value="">All statuses</asp:ListItem><asp:ListItem>Pending</asp:ListItem><asp:ListItem>Sent</asp:ListItem><asp:ListItem>Delivered</asp:ListItem><asp:ListItem>Read</asp:ListItem><asp:ListItem>Failed</asp:ListItem><asp:ListItem>Cancelled</asp:ListItem></asp:DropDownList></div><div class="comm-field"><label for="<%=txtSender.ClientID%>">Sender</label><asp:TextBox ID="txtSender" runat="server" CssClass="comm-control"/></div><div class="comm-field"><label for="<%=txtRecipient.ClientID%>">Recipient</label><asp:TextBox ID="txtRecipient" runat="server" CssClass="comm-control"/></div><div class="comm-field"><label for="<%=txtSearch.ClientID%>">Search</label><asp:TextBox ID="txtSearch" runat="server" CssClass="comm-control"/></div><div class="comm-actions"><asp:Button ID="btnFilter" runat="server" Text="Apply" CssClass="btn btn-primary" OnClick="btnFilter_Click"/><asp:Button ID="btnReset" runat="server" Text="Reset" CssClass="btn btn-secondary" OnClick="btnReset_Click"/></div></div><div class="comm-table-wrap"><asp:GridView ID="gv" runat="server" AutoGenerateColumns="false" CssClass="comm-table" GridLines="None" OnRowCommand="gv_RowCommand"><Columns><asp:BoundField DataField="Recipient" HeaderText="Recipient"/><asp:BoundField DataField="Channel" HeaderText="Channel"/><asp:BoundField DataField="Subject" HeaderText="Subject / Preview"/><asp:BoundField DataField="SentBy" HeaderText="Sent By"/><asp:BoundField DataField="SentAt" HeaderText="Sent Date" DataFormatString="{0:dd MMM yyyy HH:mm}"/><asp:BoundField DataField="Status" HeaderText="Status"/><asp:BoundField DataField="DeliveredAt" HeaderText="Delivery Date" DataFormatString="{0:dd MMM yyyy HH:mm}"/><asp:BoundField DataField="FailureReason" HeaderText="Error Message"/><asp:TemplateField HeaderText="Actions"><ItemTemplate><asp:LinkButton runat="server" CssClass="btn btn-secondary" CommandName="Details" CommandArgument='<%#Eval("DeliveryID")%>' aria-label='<%#"View delivery "+Eval("DeliveryID")%>'>View</asp:LinkButton></ItemTemplate></asp:TemplateField></Columns><EmptyDataTemplate><div class="comm-empty">No delivery records match these filters.</div></EmptyDataTemplate></asp:GridView></div><div class="comm-pager"><asp:Literal ID="litPage" runat="server"/><div class="comm-actions"><asp:Button ID="btnPrev" runat="server" Text="Previous" CssClass="btn btn-secondary" OnClick="btnPrev_Click"/><asp:Button ID="btnNext" runat="server" Text="Next" CssClass="btn btn-secondary" OnClick="btnNext_Click"/><asp:DropDownList ID="ddlPageSize" runat="server" CssClass="comm-control" AutoPostBack="true" OnSelectedIndexChanged="PageSize_Changed"><asp:ListItem>10</asp:ListItem><asp:ListItem>25</asp:ListItem><asp:ListItem>50</asp:ListItem><asp:ListItem>100</asp:ListItem></asp:DropDownList></div></div></section><div id="comm-scrim" class="comm-scrim" hidden onclick="commClose()"></div><asp:Panel ID="pnlDetails" runat="server" CssClass="comm-drawer" Visible="false" role="dialog" aria-modal="true" aria-labelledby="delivery-details-title"><div class="comm-head"><h2 id="delivery-details-title" class="text-xl font-bold">Delivery Details</h2><asp:Button ID="btnClose" runat="server" Text="Close" CssClass="btn btn-secondary" OnClick="btnClose_Click"/></div><dl class="comm-detail"><asp:Literal ID="litDetails" runat="server"/></dl></asp:Panel></section><script src="<%=ResolveUrl("~/Assets/js/modules/communication/communication-module.js?v=5")%>"></script></asp:Content>
