<%@ Page Title="Settings" Language="C#" MasterPageFile="~/MasterPages/MainMaster.master" AutoEventWireup="true" CodeBehind="Settings.aspx.cs" Inherits="AQOONHUB_SMS.Modules.Settings.SettingsPage" %><asp:Content ID="H" ContentPlaceHolderID="head" runat="server"><link rel="stylesheet" href="<%=ResolveUrl("~/Assets/css/system-module.css")%>"/><link rel="stylesheet" href="<%=ResolveUrl("~/Assets/css/system-completion.css?v=2")%>"/></asp:Content><asp:Content ID="B" ContentPlaceHolderID="MainContent" runat="server"><main class="sys-page"><header class="sys-head"><div><h1>Settings</h1><p class="sys-sub">Configure supported system preferences, school information, and appearance.</p></div><div class="sys-actions"><asp:Button ID="btnReset" runat="server" Text="Reset" CssClass="btn btn-secondary" OnClick="btnReset_Click"/><asp:Button ID="btnSave" runat="server" Text="Save Changes" CssClass="btn btn-primary" OnClick="btnSave_Click"/></div></header><asp:Literal ID="litMessage" runat="server"/><section class="sys-panel"><div class="sys-tabs" role="tablist"><button type="button" class="active" data-tab="general">General &amp; School</button><button type="button" data-tab="academic">Academic</button><button type="button" data-tab="providers">Email / SMS</button><button type="button" data-tab="security">Security</button><button type="button" data-tab="backup">Backup</button><button type="button" data-tab="appearance">Appearance</button></div><div id="general" class="sys-tab active pt-5"><div class="sys-form-grid"><div class="sys-field"><label for="<%=txtSchool.ClientID%>">School name</label><asp:TextBox ID="txtSchool" runat="server" CssClass="input"/></div><div class="sys-field"><label for="<%=txtEmail.ClientID%>">School email</label><asp:TextBox ID="txtEmail" runat="server" TextMode="Email" CssClass="input"/></div><div class="sys-field"><label for="<%=txtPhone.ClientID%>">Phone</label><asp:TextBox ID="txtPhone" runat="server" CssClass="input"/></div><div class="sys-field"><label for="<%=ddlCurrency.ClientID%>">Currency</label><asp:DropDownList ID="ddlCurrency" runat="server" CssClass="input"><asp:ListItem>USD</asp:ListItem><asp:ListItem>SOS</asp:ListItem><asp:ListItem>KES</asp:ListItem></asp:DropDownList></div><div class="sys-field"><label for="<%=txtTimezone.ClientID%>">Timezone</label><asp:TextBox ID="txtTimezone" runat="server" CssClass="input"/></div><div class="sys-field"><label for="<%=ddlLanguage.ClientID%>">Language</label><asp:DropDownList ID="ddlLanguage" runat="server" CssClass="input"><asp:ListItem>English</asp:ListItem><asp:ListItem>Somali</asp:ListItem><asp:ListItem>Arabic</asp:ListItem></asp:DropDownList></div><div class="sys-field md:col-span-2"><label for="<%=txtAddress.ClientID%>">Address</label><asp:TextBox ID="txtAddress" runat="server" TextMode="MultiLine" Rows="3" CssClass="input"/></div></div></div><div id="academic" class="sys-tab pt-5"><p class="sys-note">Current academic year and term are managed by the existing Academics module and are not duplicated here.</p></div><div id="providers" class="sys-tab pt-5"><div class="sys-note">Email provider is not configured. SMTP secrets remain in protected configuration and are never rendered. SMS provider is not configured; test actions are disabled.</div></div><div id="security" class="sys-tab pt-5"><p class="sys-note">The enforced session timeout is 30 minutes. Additional password and lockout controls are hidden because the current authentication backend does not enforce them.</p></div><div id="backup" class="sys-tab pt-5"><p class="sys-note">Automated backup support is unavailable. No simulated backup action is provided.</p></div><div id="appearance" class="sys-tab pt-5"><fieldset><legend class="font-bold mb-3">Theme</legend><div class="sys-actions"><button type="button" class="btn btn-secondary" onclick="setSysTheme('light')">Light</button><button type="button" class="btn btn-secondary" onclick="setSysTheme('dark')">Dark</button><button type="button" class="btn btn-secondary" onclick="setSysTheme('system')">System</button></div><p class="sys-sub mt-3">Uses the existing AQOONHUB theme key and does not create a second theme system.</p></fieldset></div></section><script>document.querySelectorAll('.sys-tabs button').forEach(function(b){b.addEventListener('click',function(){document.querySelectorAll('.sys-tabs button,.sys-tab').forEach(function(x){x.classList.remove('active')});b.classList.add('active');document.getElementById(b.dataset.tab).classList.add('active')})});function setSysTheme(t){localStorage.setItem('aqh_theme',t);var dark=t==='dark'||(t==='system'&&matchMedia('(prefers-color-scheme:dark)').matches);document.documentElement.classList.toggle('dark',dark);document.cookie='aqh_theme='+t+';path=/;SameSite=Lax'}</script></main></asp:Content>
