<%@ Page Title="Users & Roles" Language="C#" MasterPageFile="~/MasterPages/MainMaster.master" AutoEventWireup="true" CodeBehind="Users.aspx.cs" Inherits="AQOONHUB_SMS.Modules.Administration.Users" %>
<asp:Content ID="H" ContentPlaceHolderID="head" runat="server"><link rel="stylesheet" href="<%=ResolveUrl("~/Assets/css/system-module.css")%>"/><link rel="stylesheet" href="<%=ResolveUrl("~/Assets/css/system-completion.css?v=2")%>"/></asp:Content>
<asp:Content ID="B" ContentPlaceHolderID="MainContent" runat="server"><main class="sys-page"><header class="sys-head"><div><h1>Users &amp; Roles</h1><p class="sys-sub">Manage system users, roles, and permissions.</p></div><div class="sys-actions"><asp:LinkButton ID="btnExport" runat="server" CssClass="btn btn-secondary" OnClick="btnExport_Click"><i data-lucide="download" aria-hidden="true"></i>Export Users</asp:LinkButton><button type="button" class="btn btn-primary" data-open="createModal"><i data-lucide="user-plus" aria-hidden="true"></i>Add New User</button></div></header><asp:Literal ID="litMessage" runat="server"/><section class="sys-grid"><div class="sys-stat"><span class="sys-icon"><i data-lucide="users"></i></span><div><span>Total Users</span><b><asp:Literal ID="litTotal" runat="server"/></b></div></div><div class="sys-stat"><span class="sys-icon"><i data-lucide="user-check"></i></span><div><span>Active Users</span><b><asp:Literal ID="litActive" runat="server"/></b></div></div><div class="sys-stat"><span class="sys-icon"><i data-lucide="user-x"></i></span><div><span>Inactive Users</span><b><asp:Literal ID="litInactive" runat="server"/></b></div></div><div class="sys-stat"><span class="sys-icon"><i data-lucide="shield"></i></span><div><span>Total Roles</span><b><asp:Literal ID="litRoles" runat="server"/></b></div></div></section><div class="sys-layout"><section class="sys-panel"><div class="sys-filters"><asp:TextBox ID="txtSearch" runat="server" CssClass="input" placeholder="Search name or email" aria-label="Search users"/><asp:DropDownList ID="ddlRole" runat="server" CssClass="input" aria-label="Filter by role"/><asp:DropDownList ID="ddlStatus" runat="server" CssClass="input" aria-label="Filter by status"><asp:ListItem Value="">All statuses</asp:ListItem><asp:ListItem>Active</asp:ListItem><asp:ListItem>Inactive</asp:ListItem></asp:DropDownList><asp:Button ID="btnFilter" runat="server" Text="Apply" CssClass="btn btn-primary" OnClick="btnFilter_Click"/><asp:Button ID="btnReset" runat="server" Text="Reset" CssClass="btn btn-secondary" OnClick="btnReset_Click"/></div><div class="sys-table-wrap"><asp:GridView ID="gvUsers" runat="server" AutoGenerateColumns="false" CssClass="sys-table" GridLines="None" OnRowCommand="gvUsers_RowCommand"><Columns><asp:BoundField DataField="FullName" HeaderText="User"/><asp:BoundField DataField="Email" HeaderText="Email"/><asp:BoundField DataField="Role" HeaderText="Role"/><asp:TemplateField HeaderText="Status"><ItemTemplate><span class='<%#(bool)Eval("IsActive")?"sys-badge sys-ok":"sys-badge sys-off"%>'><%#(bool)Eval("IsActive")?"Active":"Inactive"%></span></ItemTemplate></asp:TemplateField><asp:BoundField DataField="LastLogin" HeaderText="Last Login" DataFormatString="{0:dd MMM yyyy HH:mm}"/><asp:TemplateField HeaderText="Actions"><ItemTemplate><div class="sys-actions"><asp:LinkButton runat="server" CssClass="btn btn-secondary" CommandName="ViewUser" CommandArgument='<%#Eval("UserID")%>'>View</asp:LinkButton><asp:LinkButton runat="server" CssClass="btn btn-secondary" CommandName="EditUser" CommandArgument='<%#Eval("UserID")%>'>Edit</asp:LinkButton><asp:LinkButton runat="server" CssClass="btn btn-secondary" CommandName="Deactivate" CommandArgument='<%#Eval("UserID")%>' data-confirm-deactivate="true">Deactivate</asp:LinkButton></div></ItemTemplate></asp:TemplateField></Columns><EmptyDataTemplate><div class="sys-empty">No users match the selected filters.</div></EmptyDataTemplate></asp:GridView></div><div class="sys-pager"><asp:LinkButton ID="pgFirst" runat="server" OnClick="PageNav">First</asp:LinkButton><asp:LinkButton ID="pgPrev" runat="server" OnClick="PageNav">Previous</asp:LinkButton><asp:Literal ID="litPage" runat="server"/><asp:LinkButton ID="pgNext" runat="server" OnClick="PageNav">Next</asp:LinkButton><asp:LinkButton ID="pgLast" runat="server" OnClick="PageNav">Last</asp:LinkButton><asp:DropDownList ID="ddlPageSize" runat="server" AutoPostBack="true" OnSelectedIndexChanged="PageSizeChanged" aria-label="Rows per page"><asp:ListItem>10</asp:ListItem><asp:ListItem>25</asp:ListItem><asp:ListItem>50</asp:ListItem><asp:ListItem>100</asp:ListItem></asp:DropDownList></div></section><aside class="sys-stack"><section class="sys-panel"><h2 class="font-bold mb-3">Role Permissions</h2><asp:DropDownList ID="ddlPermissionRole" runat="server" CssClass="input" AutoPostBack="true" OnSelectedIndexChanged="PermissionRoleChanged"/><div class="sys-table-wrap"><asp:GridView ID="gvPermissions" runat="server" AutoGenerateColumns="false" DataKeyNames="PermissionID" CssClass="sys-table" GridLines="None"><Columns><asp:BoundField DataField="Module" HeaderText="Module"/><asp:BoundField DataField="PermissionName" HeaderText="Permission"/><asp:TemplateField HeaderText="Assigned"><ItemTemplate><asp:CheckBox ID="chkGranted" runat="server" Checked='<%#Eval("IsGranted")%>' aria-label='<%#"Assign "+Eval("PermissionName")%>'/></ItemTemplate></asp:TemplateField></Columns><EmptyDataTemplate><div class="sys-empty">No permission records exist.</div></EmptyDataTemplate></asp:GridView></div><asp:Button ID="btnSavePermissions" runat="server" Text="Save Permissions" CssClass="btn btn-primary mt-3" OnClick="btnSavePermissions_Click"/></section><section class="sys-panel"><h2 class="font-bold mb-3">Assign Role</h2><div class="sys-stack"><asp:DropDownList ID="ddlAssignUser" runat="server" CssClass="input"/><asp:DropDownList ID="ddlAssignRole" runat="server" CssClass="input"/><asp:Button ID="btnAssign" runat="server" Text="Assign Role" CssClass="btn btn-primary" OnClick="btnAssign_Click"/></div></section></aside></div>
<asp:Panel ID="pnlDetails" runat="server" Visible="false" CssClass="sys-dialog-wrap"><section class="sys-panel sys-dialog" role="dialog" aria-modal="true" aria-labelledby="detailsTitle" tabindex="-1"><div class="sys-dialog-head"><h2 id="detailsTitle">User Details</h2><asp:Button ID="btnCloseDetails" runat="server" Text="Close" CssClass="btn btn-ghost" OnClick="CloseDetails"/></div><dl class="sys-details"><asp:Literal ID="litDetails" runat="server"/></dl></section></asp:Panel>
<asp:Panel ID="pnlEdit" runat="server" Visible="false" CssClass="sys-dialog-wrap"><section class="sys-panel sys-dialog" role="dialog" aria-modal="true" aria-labelledby="editTitle" tabindex="-1"><div class="sys-dialog-head"><h2 id="editTitle">Edit User</h2><asp:Button ID="btnCloseEdit" runat="server" Text="Close" CssClass="btn btn-ghost" OnClick="CloseEdit"/></div><asp:HiddenField ID="editId" runat="server"/><div class="sys-form-grid"><div class="sys-field"><label for="<%=editName.ClientID%>">Full name</label><asp:TextBox ID="editName" runat="server" CssClass="input"/></div><div class="sys-field"><label for="<%=editEmail.ClientID%>">Email</label><asp:TextBox ID="editEmail" runat="server" CssClass="input" TextMode="Email"/></div><div class="sys-field"><label for="<%=editPhone.ClientID%>">Phone</label><asp:TextBox ID="editPhone" runat="server" CssClass="input"/></div><div class="sys-field"><label for="<%=editRole.ClientID%>">Role</label><asp:DropDownList ID="editRole" runat="server" CssClass="input"/></div><div class="sys-check"><asp:CheckBox ID="editActive" runat="server" Text="Active user"/></div></div><asp:Button ID="btnUpdateUser" runat="server" Text="Save Changes" CssClass="btn btn-primary mt-3" OnClick="btnUpdateUser_Click"/></section></asp:Panel>
<div id="createModal" hidden class="sys-dialog-wrap"><section class="sys-panel sys-dialog" role="dialog" aria-modal="true" aria-labelledby="createTitle" tabindex="-1"><div class="sys-dialog-head"><h2 id="createTitle">Add New User</h2><button type="button" class="btn btn-ghost" data-close>Close</button></div><div class="sys-form-grid"><div class="sys-field"><label for="<%=txtName.ClientID%>">Full name</label><asp:TextBox ID="txtName" runat="server" CssClass="input"/></div><div class="sys-field"><label for="<%=txtEmail.ClientID%>">Email</label><asp:TextBox ID="txtEmail" runat="server" CssClass="input" TextMode="Email"/></div><div class="sys-field"><label for="<%=txtPhone.ClientID%>">Phone</label><asp:TextBox ID="txtPhone" runat="server" CssClass="input"/></div><div class="sys-field"><label for="<%=ddlNewRole.ClientID%>">Role</label><asp:DropDownList ID="ddlNewRole" runat="server" CssClass="input"/></div><div class="sys-field"><label for="<%=txtPassword.ClientID%>">Temporary password</label><asp:TextBox ID="txtPassword" runat="server" CssClass="input" TextMode="Password"/></div><div class="sys-check"><asp:CheckBox ID="chkActive" runat="server" Checked="true" Text="Active user"/></div></div><asp:Button ID="btnSaveUser" runat="server" Text="Create User" CssClass="btn btn-primary mt-3" OnClick="btnSaveUser_Click"/></section></div><div id="deactivateConfirmModal" hidden class="sys-dialog-wrap"><section class="sys-panel sys-dialog sys-confirm-dialog" role="dialog" aria-modal="true" aria-labelledby="deactivateConfirmTitle" tabindex="-1"><div class="sys-dialog-head"><h2 id="deactivateConfirmTitle">Deactivate user?</h2></div><p>This user will no longer be able to sign in until the account is reactivated.</p><div class="sys-actions sys-confirm-actions"><button type="button" class="btn btn-secondary" data-confirm-cancel>Cancel</button><button type="button" class="btn btn-danger" data-confirm-accept>Deactivate</button></div></section></div><script src="<%=ResolveUrl("~/Assets/js/modules/system/system-module.js?v=2")%>"></script></main></asp:Content>
