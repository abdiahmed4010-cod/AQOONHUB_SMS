<%@ Page Title="Audit Log" Language="C#" MasterPageFile="~/MasterPages/MainMaster.master" AutoEventWireup="true" CodeBehind="AuditLog.aspx.cs" Inherits="AQOONHUB_SMS.Modules.Administration.AuditLogPage" %><asp:Content ID="H" ContentPlaceHolderID="head" runat="server"><link rel="stylesheet" href="<%=ResolveUrl("~/Assets/css/system-module.css")%>"/><link rel="stylesheet" href="<%=ResolveUrl("~/Assets/css/system-completion.css?v=2")%>"/></asp:Content><asp:Content ID="B" ContentPlaceHolderID="MainContent" runat="server"><main class="sys-page"><header class="sys-head"><div><h1>Audit Log</h1><p class="sys-sub">Track system actions, updates, and security events.</p></div><asp:Button ID="btnExport" runat="server" Text="Export Log" CssClass="btn btn-primary" OnClick="btnExport_Click"/></header><asp:Literal ID="litMessage" runat="server"/><section class="sys-grid"><div class="sys-stat"><div><span>Total filtered events</span><b><asp:Literal ID="litTotal" runat="server"/></b></div></div><div class="sys-stat"><div><span>Today's events</span><b><asp:Literal ID="litToday" runat="server"/></b></div></div><div class="sys-stat"><div><span>High-risk events</span><b><asp:Literal ID="litRisk" runat="server"/></b></div></div><div class="sys-stat"><div><span>Failed actions</span><b><asp:Literal ID="litFailed" runat="server"/></b></div></div></section><section class="sys-panel"><div class="sys-filters"><asp:TextBox ID="txtFrom" runat="server" TextMode="Date" CssClass="input" aria-label="From date"/><asp:TextBox ID="txtTo" runat="server" TextMode="Date" CssClass="input" aria-label="To date"/><asp:TextBox ID="txtUser" runat="server" CssClass="input" placeholder="User or email" aria-label="User"/><asp:TextBox ID="txtModule" runat="server" CssClass="input" placeholder="Module" aria-label="Module"/><asp:TextBox ID="txtAction" runat="server" CssClass="input" placeholder="Action" aria-label="Action"/><asp:Button ID="btnFilter" runat="server" Text="Apply" CssClass="btn btn-primary" OnClick="btnFilter_Click"/><asp:Button ID="btnReset" runat="server" Text="Reset" CssClass="btn btn-secondary" OnClick="btnReset_Click"/></div><div class="sys-table-wrap"><asp:GridView ID="gv" runat="server" AutoGenerateColumns="false" CssClass="sys-table" GridLines="None" OnRowCommand="gv_RowCommand"><Columns><asp:BoundField DataField="ActionTime" HeaderText="Date & Time" DataFormatString="{0:dd MMM yyyy HH:mm:ss}"/><asp:BoundField DataField="UserName" HeaderText="User"/><asp:BoundField DataField="Module" HeaderText="Module"/><asp:BoundField DataField="Action" HeaderText="Action"/><asp:BoundField DataField="Detail" HeaderText="Description"/><asp:BoundField DataField="IPAddress" HeaderText="IP Address"/><asp:BoundField DataField="Status" HeaderText="Status"/><asp:TemplateField HeaderText="Actions"><ItemTemplate><asp:LinkButton runat="server" CssClass="btn btn-secondary" CommandName="Details" CommandArgument='<%#Eval("AuditID")%>'>View Details</asp:LinkButton></ItemTemplate></asp:TemplateField></Columns><EmptyDataTemplate><div class="sys-empty">No audit events match the selected filters.</div></EmptyDataTemplate></asp:GridView></div><div class="sys-pager"><asp:LinkButton ID="pgFirst" runat="server" OnClick="PageNav">First</asp:LinkButton><asp:LinkButton ID="pgPrev" runat="server" OnClick="PageNav">Previous</asp:LinkButton><asp:Literal ID="litPage" runat="server"/><asp:LinkButton ID="pgNext" runat="server" OnClick="PageNav">Next</asp:LinkButton><asp:LinkButton ID="pgLast" runat="server" OnClick="PageNav">Last</asp:LinkButton><asp:DropDownList ID="ddlPageSize" runat="server" AutoPostBack="true" OnSelectedIndexChanged="PageSizeChanged"><asp:ListItem>10</asp:ListItem><asp:ListItem>25</asp:ListItem><asp:ListItem>50</asp:ListItem><asp:ListItem>100</asp:ListItem></asp:DropDownList></div></section><asp:Panel ID="pnlDetails" runat="server" Visible="false" CssClass="sys-dialog-wrap"><section class="sys-panel sys-dialog" role="dialog" aria-modal="true" aria-labelledby="auditTitle" tabindex="-1"><div class="sys-dialog-head"><h2 id="auditTitle">Audit Event Details</h2><asp:Button ID="btnClose" runat="server" Text="Close" CssClass="btn btn-ghost" OnClick="CloseDetails"/></div><dl class="sys-details"><asp:Literal ID="litDetails" runat="server"/></dl></section></asp:Panel><script src="<%=ResolveUrl("~/Assets/js/modules/system/system-module.js")%>"></script></main></asp:Content>
