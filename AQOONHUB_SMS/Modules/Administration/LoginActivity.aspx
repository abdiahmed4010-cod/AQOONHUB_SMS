<%@ Page Title="Login Activity" Language="C#" MasterPageFile="~/MasterPages/MainMaster.master" AutoEventWireup="true" CodeBehind="LoginActivity.aspx.cs" Inherits="AQOONHUB_SMS.Modules.Administration.LoginActivityPage" %><asp:Content ID="H" ContentPlaceHolderID="head" runat="server"><link rel="stylesheet" href="<%=ResolveUrl("~/Assets/css/system-module.css")%>"/><link rel="stylesheet" href="<%=ResolveUrl("~/Assets/css/system-completion.css?v=2")%>"/><script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script></asp:Content><asp:Content ID="B" ContentPlaceHolderID="MainContent" runat="server"><main class="sys-page"><header class="sys-head"><div><h1>Login Activity</h1><p class="sys-sub">Monitor sign-ins, failed logins, and recorded sessions.</p></div><asp:Button ID="btnExport" runat="server" Text="Export Report" CssClass="btn btn-primary" OnClick="btnExport_Click"/></header><asp:Literal ID="litMessage" runat="server"/><section class="sys-grid"><div class="sys-stat"><div><span>Successful logins</span><b><asp:Literal ID="litSuccess" runat="server"/></b></div></div><div class="sys-stat"><div><span>Failed logins</span><b><asp:Literal ID="litFailed" runat="server"/></b></div></div><div class="sys-stat"><div><span>Active sessions</span><b>Unavailable</b></div></div><div class="sys-stat"><div><span>Suspicious attempts</span><b>Unavailable</b></div></div></section><section class="sys-panel"><div class="sys-filters"><asp:TextBox ID="txtFrom" runat="server" TextMode="Date" CssClass="input" aria-label="From date"/><asp:TextBox ID="txtTo" runat="server" TextMode="Date" CssClass="input" aria-label="To date"/><asp:TextBox ID="txtSearch" runat="server" CssClass="input" placeholder="Username or email" aria-label="User search"/><asp:DropDownList ID="ddlRole" runat="server" CssClass="input" aria-label="Role"/><asp:DropDownList ID="ddlStatus" runat="server" CssClass="input" aria-label="Status"><asp:ListItem Value="">All statuses</asp:ListItem><asp:ListItem>Success</asp:ListItem><asp:ListItem>Failed</asp:ListItem></asp:DropDownList><asp:Button ID="btnFilter" runat="server" Text="Apply" CssClass="btn btn-primary" OnClick="btnFilter_Click"/><asp:Button ID="btnReset" runat="server" Text="Reset" CssClass="btn btn-secondary" OnClick="btnReset_Click"/></div><div class="sys-table-wrap"><asp:GridView ID="gv" runat="server" AutoGenerateColumns="false" CssClass="sys-table" GridLines="None" OnRowCommand="gv_RowCommand"><Columns><asp:BoundField DataField="UserName" HeaderText="User"/><asp:BoundField DataField="Role" HeaderText="Role"/><asp:BoundField DataField="LoginTime" HeaderText="Login Time" DataFormatString="{0:dd MMM yyyy HH:mm}"/><asp:BoundField DataField="DeviceInfo" HeaderText="Device / Browser"/><asp:BoundField DataField="IPAddress" HeaderText="IP Address"/><asp:BoundField DataField="Status" HeaderText="Status"/><asp:TemplateField HeaderText="Actions"><ItemTemplate><asp:LinkButton runat="server" CssClass="btn btn-secondary" CommandName="Details" CommandArgument='<%#Eval("LoginID")%>'>View Details</asp:LinkButton></ItemTemplate></asp:TemplateField></Columns><EmptyDataTemplate><div class="sys-empty">No login activity matches the selected filters.</div></EmptyDataTemplate></asp:GridView></div><div class="sys-pager"><asp:LinkButton ID="pgFirst" runat="server" OnClick="PageNav">First</asp:LinkButton><asp:LinkButton ID="pgPrev" runat="server" OnClick="PageNav">Previous</asp:LinkButton><asp:Literal ID="litPage" runat="server"/><asp:LinkButton ID="pgNext" runat="server" OnClick="PageNav">Next</asp:LinkButton><asp:LinkButton ID="pgLast" runat="server" OnClick="PageNav">Last</asp:LinkButton><asp:DropDownList ID="ddlPageSize" runat="server" AutoPostBack="true" OnSelectedIndexChanged="PageSizeChanged"><asp:ListItem>10</asp:ListItem><asp:ListItem>25</asp:ListItem><asp:ListItem>50</asp:ListItem><asp:ListItem>100</asp:ListItem></asp:DropDownList></div></section><section class="sys-panel"><h2 class="font-bold">Login Trend</h2><div class="sys-chart"><canvas id="loginChart" aria-label="Successful and failed login trend" role="img"></canvas></div><p class="sys-note">Location and suspicious activity are unavailable because no geolocation or rule-engine data is stored.</p></section><asp:HiddenField ID="chartLabels" runat="server"/><asp:HiddenField ID="chartSuccess" runat="server"/><asp:HiddenField ID="chartFailed" runat="server"/><asp:Panel ID="pnlDetails" runat="server" Visible="false" CssClass="sys-dialog-wrap"><section class="sys-panel sys-dialog" role="dialog" aria-modal="true" aria-labelledby="loginTitle" tabindex="-1"><div class="sys-dialog-head"><h2 id="loginTitle">Login Activity Details</h2><asp:Button ID="btnClose" runat="server" Text="Close" CssClass="btn btn-ghost" OnClick="CloseDetails"/></div><dl class="sys-details"><asp:Literal ID="litDetails" runat="server"/></dl></section></asp:Panel><script>document.addEventListener('DOMContentLoaded',function(){var e=document.getElementById('loginChart');if(!e||!window.Chart)return;new Chart(e,{type:'line',data:{labels:JSON.parse(document.getElementById('<%=chartLabels.ClientID%>').value||'[]'),datasets:[{label:'Successful',data:JSON.parse(document.getElementById('<%=chartSuccess.ClientID%>').value||'[]'),borderColor:'#16a34a'},{label:'Failed',data:JSON.parse(document.getElementById('<%=chartFailed.ClientID%>').value||'[]'),borderColor:'#dc2626',borderDash:[5,4]}]},options:{responsive:true,maintainAspectRatio:false,animation:matchMedia('(prefers-reduced-motion:reduce)').matches?false:undefined}})});</script><script src="<%=ResolveUrl("~/Assets/js/modules/system/system-module.js")%>"></script></main></asp:Content>
