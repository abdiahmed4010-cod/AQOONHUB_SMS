<%@ Page Title="Saved Reports" Language="C#" MasterPageFile="~/MasterPages/MainMaster.master" AutoEventWireup="true" CodeBehind="SavedReports.aspx.cs" Inherits="AQOONHUB_SMS.Modules.Reports.SavedReports" %><asp:Content ID="H" ContentPlaceHolderID="head" runat="server"><link href="<%=ResolveUrl("~/Assets/css/reports-stage5.css")%>" rel="stylesheet"/></asp:Content><asp:Content ID="B" ContentPlaceHolderID="MainContent" runat="server"><main class="s5"><div class="s5-head"><div><h1 class="text-2xl font-bold">Saved Reports</h1><p class="text-sm text-gray-500 dark:text-slate-400">Manage approved, reusable report configurations.</p></div><a href="CustomReportBuilder.aspx" class="btn btn-primary">Create Custom Report</a></div><asp:Literal ID="litMessage" runat="server"/><div class="s5-summary"><div><b><asp:Literal ID="litTotal" runat="server"/></b><span>Total Saved</span></div><div><b><asp:Literal ID="litPrivate" runat="server"/></b><span>Private</span></div><div><b><asp:Literal ID="litRole" runat="server"/></b><span>Role-Based</span></div><div><b><asp:Literal ID="litSchool" runat="server"/></b><span>School-Wide</span></div><div><b><asp:Literal ID="litActive" runat="server"/></b><span>Active</span></div><div><b><asp:Literal ID="litRecent" runat="server"/></b><span>Recently Run</span></div></div><section class="s5-panel"><div class="s5-table"><asp:GridView ID="gv" runat="server" AutoGenerateColumns="false" DataKeyNames="SavedReportID" OnRowCommand="gv_RowCommand" GridLines="None"><Columns><asp:BoundField DataField="ReportName" HeaderText="Report Name"/><asp:BoundField DataField="Category" HeaderText="Category"/><asp:BoundField DataField="DataSource" HeaderText="Data Source"/><asp:BoundField DataField="Owner" HeaderText="Owner"/><asp:BoundField DataField="CreatedAt" HeaderText="Created" DataFormatString="{0:dd MMM yyyy}"/><asp:BoundField DataField="UpdatedAt" HeaderText="Updated" DataFormatString="{0:dd MMM yyyy}"/><asp:BoundField DataField="LastRunAt" HeaderText="Last Run" DataFormatString="{0:dd MMM yyyy HH:mm}"/><asp:BoundField DataField="Visibility" HeaderText="Visibility"/><asp:BoundField DataField="Status" HeaderText="Status"/><asp:TemplateField HeaderText="Actions"><ItemTemplate><asp:LinkButton runat="server" CommandName="RunReport" CommandArgument='<%#Eval("SavedReportID")%>' Text="Run" CssClass="text-blue-700 mr-3"/><asp:LinkButton runat="server" CommandName="DuplicateReport" CommandArgument='<%#Eval("SavedReportID")%>' Text="Duplicate" CssClass="text-violet-700 mr-3"/><asp:LinkButton runat="server" CommandName="ToggleReport" CommandArgument='<%#Eval("SavedReportID")%>' Text="Enable/Disable" CssClass="text-amber-700 mr-3"/><asp:LinkButton runat="server" CommandName="DeleteReport" CommandArgument='<%#Eval("SavedReportID")%>' Text="Delete" CssClass="text-red-700" OnClientClick="return confirm('Delete this saved report?');"/></ItemTemplate></asp:TemplateField></Columns><EmptyDataTemplate><div class="s5-empty" role="status">No saved reports are available.</div></EmptyDataTemplate></asp:GridView></div></section></main></asp:Content>
