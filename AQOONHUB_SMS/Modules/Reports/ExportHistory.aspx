<%@ Page Title="Export History" Language="C#" MasterPageFile="~/MasterPages/MainMaster.master" AutoEventWireup="true" CodeBehind="ExportHistory.aspx.cs" Inherits="AQOONHUB_SMS.Modules.Reports.ExportHistory" %>
<asp:Content ID="H" ContentPlaceHolderID="head" runat="server"><link href="<%=ResolveUrl("~/Assets/css/reports-stage5.css")%>" rel="stylesheet"/></asp:Content>
<asp:Content ID="B" ContentPlaceHolderID="MainContent" runat="server"><main class="s5"><div class="s5-head"><div><h1 class="text-2xl font-bold">Export History</h1><p class="text-sm text-gray-500 dark:text-slate-400">View safe export metadata and regenerate authorized reports.</p></div></div><asp:Literal ID="litMessage" runat="server"/><div class="s5-summary"><div><b><asp:Literal ID="litTotal" runat="server"/></b><span>Total Exports</span></div><div><b><asp:Literal ID="litCsv" runat="server"/></b><span>CSV</span></div><div><b><asp:Literal ID="litMeta" runat="server"/></b><span>Metadata Only</span></div><div><b><asp:Literal ID="litExpired" runat="server"/></b><span>Expired</span></div><div><b><asp:Literal ID="litToday" runat="server"/></b><span>Generated Today</span></div></div><section class="s5-panel"><div class="s5-table"><asp:GridView ID="gv" runat="server" AutoGenerateColumns="false" GridLines="None" OnRowCommand="gv_RowCommand"><Columns><asp:BoundField DataField="ReportName" HeaderText="Report Name"/><asp:BoundField DataField="Category" HeaderText="Category"/><asp:BoundField DataField="ExportFormat" HeaderText="Format"/><asp:BoundField DataField="GeneratedBy" HeaderText="Generated By"/><asp:BoundField DataField="GeneratedAt" HeaderText="Generated" DataFormatString="{0:dd MMM yyyy HH:mm}"/><asp:BoundField DataField="FilterSummary" HeaderText="Filter Summary"/><asp:BoundField DataField="FileStatus" HeaderText="File Status"/><asp:BoundField DataField="FileSize" HeaderText="File Size"/><asp:BoundField DataField="ExpiresAt" HeaderText="Expiration"/><asp:TemplateField HeaderText="Actions"><ItemTemplate><asp:LinkButton runat="server" Visible='<%#Convert.ToBoolean(Eval("CanRegenerate"))%>' CommandName="Regenerate" CommandArgument='<%#Eval("ReportExportID")%>' Text="Regenerate" CssClass="text-blue-700 mr-3"/><asp:LinkButton runat="server" CommandName="DeleteMetadata" CommandArgument='<%#Eval("ReportExportID")%>' Text="Delete Metadata" CssClass="text-red-700" OnClientClick="return confirm('Delete only this export metadata?');"/></ItemTemplate></asp:TemplateField></Columns><EmptyDataTemplate><div class="s5-empty">No export history is available.</div></EmptyDataTemplate></asp:GridView></div></section></main></asp:Content>
