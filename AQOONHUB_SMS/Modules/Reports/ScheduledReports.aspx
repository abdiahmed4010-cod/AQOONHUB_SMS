<%@ Page Title="Scheduled Reports" Language="C#" MasterPageFile="~/MasterPages/MainMaster.master" AutoEventWireup="true" CodeBehind="ScheduledReports.aspx.cs" Inherits="AQOONHUB_SMS.Modules.Reports.ScheduledReports" %><asp:Content ID="H" ContentPlaceHolderID="head" runat="server"><link href="<%=ResolveUrl("~/Assets/css/reports-stage5.css")%>" rel="stylesheet"/></asp:Content><asp:Content ID="B" ContentPlaceHolderID="MainContent" runat="server"><main class="s5"><div class="s5-head"><div><h1 class="text-2xl font-bold">Scheduled Reports</h1><p class="text-sm text-gray-500 dark:text-slate-400">Manage schedule definitions for a future configured runner.</p></div></div><div class="s5-msg s5-error" role="status">No scheduler or mail provider is configured. Nothing is executed or emailed.</div><asp:Literal ID="litMessage" runat="server"/><section class="s5-panel mb-4"><h2 class="font-bold mb-3"><asp:Literal ID="litFormTitle" runat="server" Text="Create Schedule"/></h2><asp:HiddenField ID="hidEditId" runat="server"/><div class="s5-grid two"><div><label class="s5-label" for="<%=ddlReport.ClientID%>">Saved report *</label><asp:DropDownList ID="ddlReport" runat="server" CssClass="s5-control"/></div><div><label class="s5-label" for="<%=ddlFrequency.ClientID%>">Frequency *</label><asp:DropDownList ID="ddlFrequency" runat="server" CssClass="s5-control"><asp:ListItem>Daily</asp:ListItem><asp:ListItem>Weekly</asp:ListItem><asp:ListItem>Monthly</asp:ListItem><asp:ListItem>Termly</asp:ListItem><asp:ListItem>Yearly</asp:ListItem></asp:DropDownList></div><div><label class="s5-label" for="<%=txtTime.ClientID%>">Run time *</label><asp:TextBox ID="txtTime" runat="server" TextMode="Time" CssClass="s5-control" Text="08:00"/></div><div><label class="s5-label" for="<%=txtDay.ClientID%>">Day (weekly 0–6; monthly 1–31)</label><asp:TextBox ID="txtDay" runat="server" TextMode="Number" CssClass="s5-control"/></div><div><label class="s5-label" for="<%=txtRecipients.ClientID%>">Recipients</label><asp:TextBox ID="txtRecipients" runat="server" TextMode="Email" CssClass="s5-control"/><p class="text-xs text-gray-500">Stored only; delivery unavailable.</p></div><div><label class="s5-label" for="<%=ddlFormat.ClientID%>">Format</label><asp:DropDownList ID="ddlFormat" runat="server" CssClass="s5-control"><asp:ListItem>CSV</asp:ListItem><asp:ListItem>Printable Report</asp:ListItem></asp:DropDownList></div></div><div class="s5-actions mt-3"><asp:Button ID="btnSave" runat="server" Text="Create Schedule" CssClass="btn btn-primary" OnClick="btnSave_Click"/><asp:Button ID="btnCancel" runat="server" Text="Cancel Edit" CssClass="btn btn-secondary" OnClick="btnCancel_Click" Visible="false" CausesValidation="false"/></div></section><section class="s5-panel"><div class="s5-table"><asp:GridView ID="gv" runat="server" AutoGenerateColumns="true" GridLines="None" OnRowCommand="gv_RowCommand"><Columns><asp:TemplateField HeaderText="Actions"><ItemTemplate><asp:LinkButton runat="server" CommandName="EditSchedule" CommandArgument='<%#Eval("ScheduledReportID")%>' Text="Edit" CssClass="text-blue-700 mr-3"/><asp:LinkButton runat="server" CommandName="EnableSchedule" CommandArgument='<%#Eval("ScheduledReportID")%>' Text="Enable" CssClass="text-emerald-700 mr-3"/><asp:LinkButton runat="server" CommandName="DisableSchedule" CommandArgument='<%#Eval("ScheduledReportID")%>' Text="Disable" CssClass="text-amber-700 mr-3"/><asp:LinkButton runat="server" CommandName="DeleteSchedule" CommandArgument='<%#Eval("ScheduledReportID")%>' Text="Delete" CssClass="text-red-700" OnClientClick="return confirm('Delete this schedule definition?');"/></ItemTemplate></asp:TemplateField></Columns><EmptyDataTemplate><div class="s5-empty">No schedules have been defined.</div></EmptyDataTemplate></asp:GridView></div></section></main></asp:Content>
