<%@ Page Title="Custom Report Builder" Language="C#" MasterPageFile="~/MasterPages/MainMaster.master" AutoEventWireup="true" CodeBehind="CustomReportBuilder.aspx.cs" Inherits="AQOONHUB_SMS.Modules.Reports.CustomReportBuilder" %>
<asp:Content ID="H" ContentPlaceHolderID="head" runat="server"><link href="<%= ResolveUrl("~/Assets/css/reports-stage5.css") %>" rel="stylesheet"/><style>.print-head{display:none}@media print{aside,header,.s5-head,.builder-ui,.s5-actions{display:none!important}.print-head{display:block!important;margin-bottom:12px}.s5{padding:0}.s5-panel{border:0;box-shadow:none}.s5-preview{overflow:visible}.s5-preview table{min-width:0;width:100%;font-size:9pt}.s5-table th,.s5-table td{white-space:normal;page-break-inside:avoid}}</style><asp:Literal ID="litPageCss" runat="server"/></asp:Content>
<asp:Content ID="B" ContentPlaceHolderID="MainContent" runat="server"><main class="s5" id="main-content"><div class="s5-head"><div><h1 class="text-2xl font-bold">Custom Report Builder</h1><p class="text-sm text-gray-500 dark:text-slate-400">Build secure reports using approved data sources, columns and filters.</p></div><a class="btn btn-secondary" href="SavedReports.aspx">Saved Reports</a></div><asp:Literal ID="litMessage" runat="server"/>
<div class="s5-grid builder builder-ui"><section class="s5-panel"><h2 class="font-bold mb-3">1. Data source and fields</h2><label class="s5-label" for="<%=ddlSource.ClientID%>">Approved data source *</label><asp:DropDownList ID="ddlSource" runat="server" CssClass="s5-control" AutoPostBack="true" OnSelectedIndexChanged="ddlSource_Changed"/><fieldset class="mt-3"><legend class="s5-label">Selected columns *</legend><asp:CheckBoxList ID="cblFields" runat="server" CssClass="s5-fields" RepeatLayout="Flow"/></fieldset></section>
<section class="s5-panel"><h2 class="font-bold mb-3">2. Filters and configuration</h2><label class="s5-label" for="<%=txtTitle.ClientID%>">Report title *</label><asp:TextBox ID="txtTitle" runat="server" CssClass="s5-control" MaxLength="150"/><div class="s5-filter-row mt-3"><div><label class="s5-label" for="<%=ddlFilterField.ClientID%>">Filter field</label><asp:DropDownList ID="ddlFilterField" runat="server" CssClass="s5-control" AutoPostBack="true" OnSelectedIndexChanged="ddlFilterField_Changed"/></div><div><label class="s5-label" for="<%=ddlOperator.ClientID%>">Operator</label><asp:DropDownList ID="ddlOperator" runat="server" CssClass="s5-control"/></div><div><label class="s5-label" for="<%=txtValue.ClientID%>">Value</label><asp:TextBox ID="txtValue" runat="server" CssClass="s5-control"/></div></div><div class="s5-grid two mt-3"><div><label class="s5-label" for="<%=ddlSort.ClientID%>">Sort field</label><asp:DropDownList ID="ddlSort" runat="server" CssClass="s5-control"/></div><div><label class="s5-label" for="<%=ddlDirection.ClientID%>">Direction</label><asp:DropDownList ID="ddlDirection" runat="server" CssClass="s5-control"><asp:ListItem Value="asc">Ascending</asp:ListItem><asp:ListItem Value="desc">Descending</asp:ListItem></asp:DropDownList></div></div></section>
<section class="s5-panel"><h2 class="font-bold mb-3">3. Preview settings</h2><label class="s5-label" for="<%=ddlOrientation.ClientID%>">Page orientation</label><asp:DropDownList ID="ddlOrientation" runat="server" CssClass="s5-control"><asp:ListItem>Portrait</asp:ListItem><asp:ListItem>Landscape</asp:ListItem></asp:DropDownList><label class="s5-label mt-3" for="<%=ddlVisibility.ClientID%>">Visibility</label><asp:DropDownList ID="ddlVisibility" runat="server" CssClass="s5-control"><asp:ListItem>Private</asp:ListItem><asp:ListItem>Role-Based</asp:ListItem><asp:ListItem>School-Wide</asp:ListItem></asp:DropDownList><p class="text-xs text-gray-500 dark:text-slate-400 mt-3">Preview is limited to 100 rows. Exports are capped by the selected source. SQL and physical table names are never accepted.</p></section></div>
<div class="s5-actions my-4"><asp:Button ID="btnPreview" runat="server" Text="Preview Report" CssClass="btn btn-primary" OnClick="btnPreview_Click"/><asp:Button ID="btnSave" runat="server" Text="Save Report" CssClass="btn btn-secondary" OnClick="btnSave_Click"/><asp:Button ID="btnExport" runat="server" Text="Export CSV" CssClass="btn btn-secondary" OnClick="btnExport_Click"/><button type="button" class="btn btn-secondary" onclick="window.print()">Print</button><asp:Button ID="btnReset" runat="server" Text="Reset" CssClass="btn btn-secondary" OnClick="btnReset_Click" CausesValidation="false"/></div>
<section class="s5-panel"><div class="print-head"><div class="text-lg font-bold">AQOONHUB SMS</div><div class="text-base font-semibold"><asp:Literal ID="litPrintTitle" runat="server"/></div><asp:Literal ID="litPrintMeta" runat="server"/></div><div class="flex justify-between flex-wrap gap-2"><h2 class="font-bold">Preview</h2><asp:Literal ID="litSummary" runat="server"/></div><div class="s5-table s5-preview"><asp:GridView ID="gvPreview" runat="server" AutoGenerateColumns="true" CssClass="w-full" GridLines="None"><EmptyDataTemplate><div class="s5-empty" role="status">Configure approved fields and select Preview Report.</div></EmptyDataTemplate></asp:GridView></div></section></main></asp:Content>
