<%@ Page Title="Invoice | AQOONHUB SMS" Language="C#" MasterPageFile="~/MasterPages/MainMaster.master" AutoEventWireup="true" CodeBehind="PrintInvoice.aspx.cs" Inherits="AQOONHUB_SMS.Modules.Finance.PrintInvoice" %>
<asp:Content ID="h" ContentPlaceHolderID="head" runat="server"><style>.paper{max-width:850px;margin:1.5rem auto;background:#fff;padding:2.5rem;border:1px solid #e5e7eb}.row{display:flex;justify-content:space-between;gap:2rem}.totals{margin-left:auto;width:300px}.totals div{display:flex;justify-content:space-between;padding:.4rem}@media print{#sidebar,header,footer,.no-print{display:none!important}.paper{border:0;margin:0;max-width:none;padding:0}#main-content{margin:0!important}}</style></asp:Content>
<asp:Content ID="b" ContentPlaceHolderID="MainContent" runat="server"><div class="paper"><div class="no-print flex justify-end gap-2 mb-5"><button class="btn btn-primary" onclick="window.print();return false">Print Invoice</button><a class="btn btn-secondary" href="FeeManagement.aspx">Back</a><asp:HyperLink ID="pay" runat="server" CssClass="btn btn-secondary">Record Payment</asp:HyperLink></div><div class="row border-b pb-5"><div class="flex gap-3"><img src="../../Assets/images/logo.png" class="w-14 h-14"/><div><h1 class="text-xl font-bold">AQOONHUB School Management System</h1><p class="text-sm">School address · Phone · Email</p></div></div><div class="text-right"><h2 class="text-2xl font-bold text-blue-600">INVOICE</h2><asp:Label ID="number" runat="server"/></div></div><div class="row py-5"><div><b>Bill To</b><p><asp:Label ID="student" runat="server"/></p><p><asp:Label ID="studentCode" runat="server"/></p><p><asp:Label ID="classInfo" runat="server"/></p></div><div><p>Invoice Date: <asp:Label ID="invoiceDate" runat="server"/></p><p>Due Date: <asp:Label ID="dueDate" runat="server"/></p><p>Academic Year: <asp:Label ID="year" runat="server"/></p><p>Status: <asp:Label ID="status" runat="server"/></p></div></div><asp:GridView ID="items" runat="server" AutoGenerateColumns="false" CssClass="w-full text-sm" GridLines="None"><Columns><asp:BoundField DataField="FeeCategoryName" HeaderText="Fee Item"/><asp:BoundField DataField="Description" HeaderText="Description"/><asp:BoundField DataField="Amount" HeaderText="Amount" DataFormatString="{0:N2}"/><asp:BoundField DataField="DiscountAmount" HeaderText="Discount" DataFormatString="{0:N2}"/><asp:BoundField DataField="TotalAmount" HeaderText="Total" DataFormatString="{0:N2}"/></Columns></asp:GridView><div class="totals mt-5"><div><span>Subtotal</span><asp:Label ID="subtotal" runat="server"/></div><div><span>Discount</span><asp:Label ID="discount" runat="server"/></div><div class="font-bold border-t"><span>Total</span><asp:Label ID="total" runat="server"/></div><div><span>Paid</span><asp:Label ID="paid" runat="server"/></div><div class="font-bold text-blue-600"><span>Balance</span><asp:Label ID="balance" runat="server"/></div></div><div class="mt-8"><p><b>Remarks:</b> <asp:Label ID="remarks" runat="server"/></p><p><b>Payment Instructions:</b> <asp:Label ID="instructions" runat="server"/></p><p class="mt-8">Prepared by: <asp:Label ID="prepared" runat="server"/> __________________ Signature</p></div></div></asp:Content>
