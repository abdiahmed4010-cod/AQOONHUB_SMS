<%@ Page Title="Payment Receipt | AQOONHUB SMS" Language="C#" MasterPageFile="~/MasterPages/MainMaster.master" AutoEventWireup="true" CodeBehind="PrintReceipt.aspx.cs" Inherits="AQOONHUB_SMS.Modules.Finance.PrintReceipt" %>
<asp:Content ID="h" ContentPlaceHolderID="head" runat="server"><style>.receipt{max-width:700px;margin:2rem auto;background:white;padding:2.5rem;border:1px solid #e5e7eb}.rr{display:flex;justify-content:space-between;padding:.65rem;border-bottom:1px solid #eef2f7}@media print{#sidebar,header,footer,.no-print{display:none!important}.receipt{border:0;margin:0}}</style></asp:Content>
<asp:Content ID="b" ContentPlaceHolderID="MainContent" runat="server"><div class="receipt"><div class="no-print flex justify-end gap-2"><button class="btn btn-primary" onclick="window.print();return false">Print Receipt</button><a class="btn btn-secondary" href="FeeManagement.aspx">Back</a><asp:HyperLink ID="invoiceLink" runat="server" CssClass="btn btn-secondary">View Invoice</asp:HyperLink></div><div class="text-center border-b pb-5"><img src="../../Assets/images/logo.png" class="w-14 h-14 mx-auto"/><h1 class="text-xl font-bold">AQOONHUB School Management System</h1><h2 class="text-blue-600 font-bold mt-3">PAYMENT RECEIPT</h2></div><asp:Repeater ID="details" runat="server"><ItemTemplate><div class="mt-4"><div class="rr"><b>Receipt Number</b><span><%#: Eval("ReceiptNumber") %></span></div><div class="rr"><b>Payment Date</b><span><%# Convert.ToDateTime(Eval("PaymentDate")).ToString("dd MMM yyyy") %></span></div><div class="rr"><b>Student</b><span><%#: Eval("StudentName") %> (<%#: Eval("StudentCode") %>)</span></div><div class="rr"><b>Invoice Number</b><span><%#: Eval("InvoiceNumber") %></span></div><div class="rr"><b>Amount Paid</b><strong><%# Convert.ToDecimal(Eval("AmountPaid")).ToString("N2") %></strong></div><div class="rr"><b>Payment Method</b><span><%#: Eval("PaymentMethod") %></span></div><div class="rr"><b>Transaction Reference</b><span><%#: Eval("ReferenceNumber") %></span></div><div class="rr"><b>Previous Balance</b><span><%# Convert.ToDecimal(Eval("PreviousBalance")).ToString("N2") %></span></div><div class="rr"><b>New Balance</b><span><%# Convert.ToDecimal(Eval("NewBalance")).ToString("N2") %></span></div><div class="rr"><b>Received By</b><span><%#: Eval("ReceivedByName") %></span></div><p class="mt-10">Authorized signature: __________________________</p></div></ItemTemplate></asp:Repeater></div></asp:Content>
